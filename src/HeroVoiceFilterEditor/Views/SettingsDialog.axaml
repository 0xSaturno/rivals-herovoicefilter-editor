<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeroVoiceFilterEditor.ViewModels"
        x:Class="HeroVoiceFilterEditor.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="720" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Mica,None">

  <Panel>
    <Border Background="#990B0B0D" />
    <DockPanel Margin="18">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Save" Click="OnAccept" IsDefault="True" />
    </StackPanel>

    <StackPanel Spacing="14">

      <StackPanel Spacing="6">
        <TextBlock Text="Marvel Rivals Paks directory" FontWeight="SemiBold" FontSize="12" />
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox Text="{Binding PaksDirectory}" Watermark="…\MarvelGame\Marvel\Content\Paks" />
          <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
          <Button Grid.Column="2" Content="Autodetect" Margin="6,0,0,0" Command="{Binding AutodetectCommand}" />
        </Grid>
        <TextBlock Text="{Binding PaksValidation}" FontSize="11" Opacity="0.7" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="AES key" FontWeight="SemiBold" FontSize="12" />
        <TextBox Text="{Binding AesKey}" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                 Padding="10,0" VerticalContentAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Usmap override" FontWeight="SemiBold" FontSize="12" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding UsmapOverridePath}" Watermark="(leave empty to auto-update from rivals-depot)" />
          <Button Grid.Column="1" Content="Clear" Margin="8,0,0,0" Command="{Binding ClearUsmapCommand}" />
        </Grid>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Workspace" FontWeight="SemiBold" FontSize="12" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding WorkspaceDirectory}" Watermark="(default: LocalAppData\HeroVoiceFilterEditor\workspace)" />
          <Button Grid.Column="1" Content="Open workspace folder" Margin="8,0,0,0"
                  Command="{Binding OpenWorkspaceCommand}" />
        </Grid>
      </StackPanel>

      <CheckBox Content="Check for usmap and hero-name updates on launch"
                IsChecked="{Binding CheckForUpdatesOnLaunch}" />

      <CheckBox Content="Show log pane"
                IsChecked="{Binding ShowLogPane}" />

    </StackPanel>
    </DockPanel>
  </Panel>

</Window>
