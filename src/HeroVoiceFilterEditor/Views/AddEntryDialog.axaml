<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeroVoiceFilterEditor.ViewModels"
        x:Class="HeroVoiceFilterEditor.Views.AddEntryDialog"
        x:DataType="vm:AddEntryViewModel"
        Title="Add entry"
        Width="560" Height="620"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Text="Pick a skin, or type any 7-digit id if it is too new to be listed."
                 Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
      <TextBox Text="{Binding Query}" Watermark="Search hero or skin name…" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,12,0,0">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Raw id" VerticalAlignment="Center" Opacity="0.65" Margin="0,0,10,0" />
        <TextBox Grid.Column="1" Text="{Binding RawId}" Watermark="e.g. 1015503" />
      </Grid>
      <TextBlock Text="{Binding Validation}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="OnCancel" />
        <Button Content="Add entry" Click="OnAccept" IsEnabled="{Binding CanAccept}" IsDefault="True" />
      </StackPanel>
    </StackPanel>

    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Margin="0,10">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SkinChoice">
          <Grid ColumnDefinitions="90,*,Auto" Margin="0,2"
                AutomationProperties.Name="{Binding Display}">
            <TextBlock Text="{Binding SkinId}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Opacity="0.55" />
            <TextBlock Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="already added" FontSize="11" Foreground="#FFD479"
                       IsVisible="{Binding AlreadyPresent}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>

</Window>
