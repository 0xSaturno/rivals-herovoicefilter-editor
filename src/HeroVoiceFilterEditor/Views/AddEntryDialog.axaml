<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeroVoiceFilterEditor.ViewModels"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="HeroVoiceFilterEditor.Views.AddEntryDialog"
        x:DataType="vm:AddEntryViewModel"
        Title="Add entry"
        Width="560" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Mica,None">

  <Window.Styles>
    <Style Selector="mi|MaterialIcon.expanded">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="Button.chevron">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Panel>
    <Border Background="#990B0B0D" />
    <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Text="Pick a skin, or type any 7-digit id if it is missing."
                 Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
      <TextBox Text="{Binding Query}" Watermark="Search hero or skin name…" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,12,0,0">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Raw id" VerticalAlignment="Center" Opacity="0.65" Margin="0,0,10,0" />
        <TextBox Grid.Column="1" Text="{Binding RawId}" Watermark="e.g. 1015503" />
      </Grid>
      <TextBlock Text="{Binding Validation}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="OnCancel" />
        <Button Content="{Binding AddLabel}" Click="OnAccept" IsEnabled="{Binding CanAccept}" IsDefault="True" />
      </StackPanel>
    </StackPanel>

    <ListBox ItemsSource="{Binding Results}" Margin="0,10">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ResultRow">
          <Grid ColumnDefinitions="26,24,26,80,*,Auto" Margin="0,1"
                AutomationProperties.Name="{Binding Skin.Display}">
            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" IsEnabled="{Binding !Skin.AlreadyPresent}"
                      Command="{Binding $parent[Window].((vm:AddEntryViewModel)DataContext).ToggleSelectCommand}"
                      CommandParameter="{Binding Skin.SkinId}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="chevron"
                    Command="{Binding $parent[Window].((vm:AddEntryViewModel)DataContext).ToggleExpandCommand}"
                    CommandParameter="{Binding HeroId}"
                    IsVisible="{Binding HasAltSkins}">
              <mi:MaterialIcon Kind="ChevronRight" Width="16" Height="16"
                                Classes.expanded="{Binding IsExpanded}" />
            </Button>
            <TextBlock Grid.Column="2" Text="alt" FontSize="11" Opacity="0.45" VerticalAlignment="Center"
                       IsVisible="{Binding IsAlt}" />
            <Border Grid.Column="3" Classes="pill pillId" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{Binding Skin.SkinId}" />
            </Border>
            <TextBlock Grid.Column="4" Text="{Binding Skin.Display}" TextTrimming="CharacterEllipsis"
                       Classes.header="{Binding IsHeader}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="already added" FontSize="11" Foreground="#FFD479"
                       VerticalAlignment="Center" IsVisible="{Binding Skin.AlreadyPresent}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    </DockPanel>
  </Panel>

</Window>
