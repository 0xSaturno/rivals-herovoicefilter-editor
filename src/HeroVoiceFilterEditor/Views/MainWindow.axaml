<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeroVoiceFilterEditor.ViewModels"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="HeroVoiceFilterEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hero Voice Filter Editor"
        Width="1280" Height="820"
        MinWidth="1000" MinHeight="640"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Mica,None">

  <Window.Resources>
    <SolidColorBrush x:Key="Hairline" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="PanelBg" Color="#12FFFFFF" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Button.iconText StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="Button.iconText mi|MaterialIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource PanelBg}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Pills / chips -->
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>
    <Style Selector="Border.pill TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pillId">
      <Setter Property="Background" Value="#1D6FA8DC" />
    </Style>
    <!-- Consolas' line metrics sit higher than the UI font's, so a plain center-align still
         looks off inside a tight pill; pinning LineHeight to the font size removes that. -->
    <Style Selector="Border.pillId TextBlock">
      <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
      <Setter Property="LineHeight" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#9AD0F5" />
    </Style>
    <Style Selector="Border.pillFilter">
      <Setter Property="Background" Value="#1D9B7FE0" />
    </Style>
    <Style Selector="Border.pillFilter TextBlock">
      <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
      <Setter Property="LineHeight" Value="11" />
      <Setter Property="Foreground" Value="#D2C4F7" />
    </Style>
    <Style Selector="Border.pillMuted">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.pillMuted TextBlock">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Border.pillBadge">
      <Setter Property="Background" Value="#33FFD479" />
    </Style>
    <Style Selector="Border.pillBadge TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#FFD479" />
    </Style>
    <!-- A white-based tint brightens whatever's behind it — fine over solid black, but it
         washes out badly layered over the acrylic blur. A black-based tint darkens instead. -->
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="#40000000" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Entry list cards -->
    <Style Selector="ListBox.entries">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.entries ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.entryCard">
      <Setter Property="Background" Value="{StaticResource PanelBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <!-- Deliberately near-opaque rather than a light tint: a low-alpha selection color inherits
         too much of whatever's blurred behind the window at that scroll position, so it reads
         as "randomly bright" depending on backdrop rather than a consistent selected state. -->
    <Style Selector="Border.entryCard.selected">
      <Setter Property="Background" Value="#E0163C57" />
      <Setter Property="BorderBrush" Value="#B32E6C97" />
    </Style>
  </Window.Styles>

  <Panel>
    <!-- AcrylicBlur is requested ahead of Mica: Avalonia's Win32 Mica brush needs a WinUI
         composition runtime that isn't guaranteed present, and it reports ActualTransparencyLevel
         as "Mica" (success) even when that brush silently fails to render — so once Mica is
         accepted, Avalonia never falls through to Acrylic on its own. Verified against real
         composited screen pixels (not a window-content-only capture, which can't see this layer
         at all): Acrylic renders correctly here, Mica does not. Falls back to plain opaque black
         on Windows 10 / non-Windows, where TransparencyLevelHint degrades to None. -->
    <Border Background="#990B0B0D" />

    <DockPanel>

    <!-- Top bar -->
    <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="iconText" Command="{Binding RefreshFromGameCommand}" IsEnabled="{Binding !IsBusy}">
            <StackPanel>
              <mi:MaterialIcon Kind="Refresh" />
              <TextBlock Text="Refresh from game" />
            </StackPanel>
          </Button>
          <Border Width="1" Background="{StaticResource Hairline}" Margin="4,2" />
          <Button Classes="iconText" Command="{Binding OpenProjectCommand}" IsEnabled="{Binding IsReady}">
            <StackPanel>
              <mi:MaterialIcon Kind="FolderOpen" />
              <TextBlock Text="Open project" />
            </StackPanel>
          </Button>
          <Button Classes="iconText" Command="{Binding SaveProjectCommand}" IsEnabled="{Binding IsReady}">
            <StackPanel>
              <mi:MaterialIcon Kind="ContentSave" />
              <TextBlock Text="Save project" />
            </StackPanel>
          </Button>
          <Border Width="1" Background="{StaticResource Hairline}" Margin="4,2" />
          <Button Classes="iconText" Command="{Binding ExportAssetCommand}" IsEnabled="{Binding IsReady}">
            <StackPanel>
              <mi:MaterialIcon Kind="Export" />
              <TextBlock Text="Export .uasset" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" ClipToBounds="True">
          <TextBlock Text="{Binding Provenance}" Classes="dim"
                     TextAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="unsaved changes" FontSize="11" Foreground="#FFD479"
                     TextAlignment="Center" IsVisible="{Binding HasUnsavedChanges}" />
        </StackPanel>

        <Button Grid.Column="2" Classes="iconText" Command="{Binding OpenSettingsCommand}">
          <StackPanel>
            <mi:MaterialIcon Kind="Cog" />
            <TextBlock Text="Settings" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Hairline}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ProgressBar IsIndeterminate="True" Width="90" Height="3" VerticalAlignment="Center"
                     Margin="0,0,10,0" IsVisible="{Binding IsBusy}" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="dim" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding UsmapLabel}" Classes="dim" />
          <TextBlock Text="{Binding BackendVersion}" Classes="dim" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Log -->
    <Border DockPanel.Dock="Bottom" Height="128" Padding="12,8"
            BorderThickness="0,1,0,0" BorderBrush="{StaticResource Hairline}"
            IsVisible="{Binding ShowLogPane}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Log" Classes="section" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Opacity="0.7" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Body -->
    <Grid ColumnDefinitions="420,Auto,*">

      <!-- Entry list -->
      <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
          <TextBox Text="{Binding SearchText}" Watermark="Search hero, skin name, id or filter…" />
          <Grid ColumnDefinitions="*,Auto,Auto">
            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Classes="iconText" Margin="8,0,0,0"
                    Command="{Binding AddEntryCommand}" IsEnabled="{Binding IsReady}">
              <StackPanel>
                <mi:MaterialIcon Kind="Plus" />
                <TextBlock Text="Add" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="iconText" Margin="6,0,0,0" Command="{Binding RemoveEntryCommand}">
              <StackPanel>
                <mi:MaterialIcon Kind="Minus" />
                <TextBlock Text="Remove" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Text="{Binding EntryCountText}" Classes="dim" />
        </StackPanel>

        <ListBox Classes="entries" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding SelectedEntry}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EntryViewModel">
              <Border Classes="entryCard" Classes.selected="{Binding $parent[ListBoxItem].IsSelected}"
                      AutomationProperties.Name="{Binding DisplayName}"
                      AutomationProperties.HelpText="{Binding SlotSummary}">
                <StackPanel Spacing="8">

                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="pill pillId">
                      <TextBlock Text="{Binding SkinId}" />
                    </Border>
                    <Border Grid.Column="1" Classes="chip" Margin="8,0,0,0">
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Border Grid.Column="2" Classes="pill pillBadge" Margin="8,0,0,0"
                            IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Badge}" />
                    </Border>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding FilterChips}" IsVisible="{Binding HasFilters}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Classes="pill pillFilter" Margin="0,0,6,6">
                          <TextBlock Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Classes="pillMuted" HorizontalAlignment="Left" IsVisible="{Binding !HasFilters}">
                    <TextBlock Text="no filters" />
                  </Border>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <Border Grid.Column="1" Width="1" Background="{StaticResource Hairline}" />

      <!-- Detail -->
      <ScrollViewer Grid.Column="2" Margin="16">
        <Panel>
          <TextBlock Text="Select an entry to edit its voice filters."
                     Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNull}}" />

          <Border IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="16" DataContext="{Binding SelectedEntry}" x:DataType="vm:EntryViewModel">

            <StackPanel Spacing="2">
              <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding SkinId, StringFormat='skin {0}'}" Classes="dim" />
                <TextBlock Text="not in the id list" Classes="dim" Foreground="#FFD479"
                           IsVisible="{Binding !IsNamed}" />
              </StackPanel>
            </StackPanel>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="QUICK FILL" Classes="section" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).FamilyNames}"
                            SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedFamily}"
                            PlaceholderText="Choose a filter family…" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="1" Content="Apply" Margin="8,0,0,0"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ApplyFamilyCommand}" />
                  <Button Grid.Column="2" Content="Clear all" Margin="6,0,0,0"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearSlotsCommand}" />
                </Grid>
                <TextBlock Text="Fills slots in order from the family. Slots stay free-form — any effect can go in any slot."
                           Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="FILTER SLOTS" Classes="section" />
                <ItemsControl ItemsSource="{Binding Slots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlotViewModel">
                      <Grid ColumnDefinitions="70,*" Margin="0,4">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Classes="dim" />
                        <!-- SelectedItem alone drives this — AutoCompleteBox derives its
                             displayed Text from it. Binding Text too raced the two on every
                             re-attach (i.e. every row selection) and could clobber the slot. -->
                        <AutoCompleteBox Grid.Column="1"
                                         ItemsSource="{Binding Available}"
                                         SelectedItem="{Binding SelectedName}"
                                         FilterMode="ContainsOrdinal"
                                         MinimumPrefixLength="0"
                                         HorizontalAlignment="Stretch" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
          </Border>
        </Panel>
      </ScrollViewer>

    </Grid>
    </DockPanel>
  </Panel>

</Window>
