<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeroVoiceFilterEditor.ViewModels"
        x:Class="HeroVoiceFilterEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hero Voice Filter Editor"
        Width="1180" Height="760"
        MinWidth="940" MinHeight="600">

  <DockPanel>

    <Border DockPanel.Dock="Bottom"
            Padding="12,6"
            BorderThickness="0,1,0,0"
            BorderBrush="#33FFFFFF">
      <TextBlock Text="{Binding BackendStatus}" FontSize="12" Opacity="0.7" />
    </Border>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
      <TextBlock Text="Hero Voice Filter Editor" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Stage}" FontSize="14" Opacity="0.6" HorizontalAlignment="Center" />
    </StackPanel>

  </DockPanel>

</Window>
